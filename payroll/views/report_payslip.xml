<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template id="payslip_professional_document">
        <t t-call="web.external_layout">
            <div class="page pt-payroll-slip">
                <style>
                    .pt-payroll-slip { color: #111; font-family: Arial, sans-serif; font-size: 10.5px; line-height: 1.3; }
                    .pt-payroll-slip * { box-sizing: border-box; }
                    .pt-payroll-slip .pt-slip-header { margin-bottom: 8px; overflow: hidden; border: 1.5px solid; border-radius: 9px; page-break-inside: avoid; }
                    .pt-payroll-slip .pt-slip-hero { width: 100%; border-collapse: collapse; table-layout: fixed; color: #fff; }
                    .pt-payroll-slip .pt-slip-hero td { padding: 0; vertical-align: middle; }
                    .pt-payroll-slip .pt-hero-document { width: 55% !important; padding: 11px 16px 10px !important; }
                    .pt-payroll-slip .pt-hero-employee { width: 45% !important; padding: 11px 15px 10px !important; border-left: 1px solid rgba(255, 255, 255, .85); }
                    .pt-payroll-slip .pt-hero-title { display: block; margin-bottom: 5px; font-size: 22px; font-weight: 900; letter-spacing: .035em; line-height: 1; }
                    .pt-payroll-slip .pt-hero-period { font-size: 10.5px; letter-spacing: .12em; text-transform: uppercase; }
                    .pt-payroll-slip .pt-hero-period strong { font-size: 11.5px; letter-spacing: .06em; }
                    .pt-payroll-slip .pt-hero-name { display: block; overflow: hidden; font-size: 15px; font-weight: 900; line-height: 1.15; text-overflow: ellipsis; text-transform: uppercase; white-space: nowrap; }
                    .pt-payroll-slip .pt-hero-role { display: block; margin-top: 6px; font-size: 9px; font-weight: 600; letter-spacing: .18em; text-transform: uppercase; }
                    .pt-payroll-slip .pt-slip-meta { width: 100%; border-collapse: collapse; table-layout: fixed; }
                    .pt-payroll-slip .pt-slip-meta &gt; tbody &gt; tr &gt; td { width: 50%; padding: 10px 15px 9px; vertical-align: top; }
                    .pt-payroll-slip .pt-slip-meta-left { border-right: 1px solid #d4dce6; }
                    .pt-payroll-slip .pt-meta-row { display: table; width: 100%; min-height: 18px; margin-bottom: 3px; table-layout: fixed; font-size: 10px; line-height: 1.25; }
                    .pt-payroll-slip .pt-meta-row &gt; span { display: table-cell; vertical-align: top; }
                    .pt-payroll-slip .pt-meta-label { width: 31%; font-weight: 800; }
                    .pt-payroll-slip .pt-meta-separator { width: 5%; font-weight: 800; text-align: center; }
                    .pt-payroll-slip .pt-meta-value { width: 64%; }
                    .pt-payroll-slip .pt-slip-number { margin-top: 5px; padding: 7px 10px; border-radius: 6px; background: #eef3f8; }
                    .pt-payroll-slip .pt-slip-number .pt-meta-label { width: 30%; font-size: 11px; }
                    .pt-payroll-slip .pt-slip-number .pt-meta-separator { width: 5%; font-size: 11px; }
                    .pt-payroll-slip .pt-slip-number .pt-meta-value { width: 65%; font-size: 18px; font-weight: 900; letter-spacing: .04em; }
                    .pt-payroll-slip table { width: 100%; border-collapse: collapse; table-layout: fixed; }
                    .pt-payroll-slip .pt-lines { margin-top: 4px; border: 1.8px solid #111; page-break-inside: auto; }
                    .pt-payroll-slip .pt-lines thead { display: table-header-group; }
                    .pt-payroll-slip .pt-lines tr { page-break-inside: avoid; }
                    .pt-payroll-slip .pt-lines th { padding: 5px 3px; border: 1px solid #111; font-size: 9px; font-weight: 800; text-align: center; vertical-align: middle; }
                    .pt-payroll-slip .pt-lines td { height: 23px; padding: 4px; border-right: 1px solid #111; font-size: 9.5px; vertical-align: middle; }
                    .pt-payroll-slip .pt-lines tbody tr:last-child td { padding-bottom: 8px; }
                    .pt-payroll-slip .pt-code { width: 8%; }
                    .pt-payroll-slip .pt-name { width: 31%; }
                    .pt-payroll-slip .pt-base { width: 12%; }
                    .pt-payroll-slip .pt-rate { width: 8%; }
                    .pt-payroll-slip .pt-value { width: 11%; }
                    .pt-payroll-slip .pt-number { text-align: right; white-space: nowrap; }
                    .pt-payroll-slip .pt-summary-line td { padding-top: 6px; border-top: 1px solid #111; font-weight: 800; }
                    .pt-payroll-slip .pt-structure-subtotal td { padding: 6px 4px; border-top: 1.5px solid #111; border-bottom: 1.5px solid #111; background: #f2f2f2; font-size: 9.5px; font-weight: 800; }
                    .pt-payroll-slip .pt-totals { border: 1.8px solid #111; border-top: 0; page-break-inside: avoid; }
                    .pt-payroll-slip .pt-totals td { padding: 5px 3px; border-right: 1px solid #111; text-align: center; vertical-align: middle; }
                    .pt-payroll-slip .pt-totals small { display: block; min-height: 22px; font-size: 8.5px; font-weight: 700; }
                    .pt-payroll-slip .pt-totals strong { display: block; margin-top: 3px; font-size: 12px; white-space: nowrap; }
                    .pt-payroll-slip .pt-totals .pt-net { border: 2px solid #111; background: #dedede; }
                    .pt-payroll-slip .pt-totals .pt-net strong { font-size: 16px; }
                    .pt-payroll-slip .pt-note { margin-top: 9px; padding: 6px; border: 1px solid #aaa; page-break-inside: avoid; }
                </style>

                <t t-set="structure_groups" t-value="o._get_report_structure_groups()"/>
                <t t-set="report_totals" t-value="o._dashboard_amounts()"/>
                <t t-set="gross_codes" t-value="('GROSS', 'BRUT', 'SAL_BRUT')"/>
                <t t-set="gross_total" t-value="report_totals['gross']"/>
                <t t-set="deduction_total" t-value="report_totals['deductions']"/>
                <t t-set="employer_total" t-value="report_totals['employer']"/>
                <t t-set="net_total" t-value="report_totals['net']"/>

                <t t-set="theme_primary" t-value="o.company_id.primary_color or '#714B67'"/>
                <t t-set="theme_secondary" t-value="o.company_id.secondary_color or theme_primary"/>
                <div class="pt-slip-header" t-att-style="'border-color: %s;' % theme_primary">
                    <table class="pt-slip-hero" t-att-style="'background-color: ' + theme_primary + '; background-image: -webkit-linear-gradient(335deg, ' + theme_primary + ' 0%, ' + theme_secondary + ' 100%);'">
                        <colgroup>
                            <col style="width: 55%;"/>
                            <col style="width: 45%;"/>
                        </colgroup>
                        <tbody>
                            <tr>
                                <td class="pt-hero-document" width="55%">
                                    <strong class="pt-hero-title">BULLETIN DE PAIE</strong>
                                    <span class="pt-hero-period">Période du <strong t-field="o.date_from"/> au <strong t-field="o.date_to"/></span>
                                </td>
                                <td class="pt-hero-employee" width="45%">
                                    <strong class="pt-hero-name" t-field="o.employee_id.name"/>
                                    <span class="pt-hero-role">Salarié</span>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                    <table class="pt-slip-meta">
                        <tbody>
                            <tr>
                                <td class="pt-slip-meta-left">
                                    <div class="pt-meta-row"><span class="pt-meta-label">Période</span><span class="pt-meta-separator">:</span><span class="pt-meta-value">Du <span t-field="o.date_from"/> au <span t-field="o.date_to"/></span></div>
                                    <div class="pt-meta-row"><span class="pt-meta-label">Date de paiement</span><span class="pt-meta-separator">:</span><span class="pt-meta-value" t-field="o.date_to"/></div>
                                    <div class="pt-meta-row"><span class="pt-meta-label">Mode de règlement</span><span class="pt-meta-separator">:</span><strong class="pt-meta-value" t-if="o.payment_journal_id" t-field="o.payment_journal_id.name"/><span class="pt-meta-value" t-else="">Non renseigné</span></div>
                                    <div class="pt-meta-row pt-slip-number">
                                        <span class="pt-meta-label">N° du bulletin</span><span class="pt-meta-separator">:</span><strong class="pt-meta-value" t-field="o.number" t-att-style="'color: %s;' % theme_primary"/>
                                    </div>
                                </td>
                                <td>
                                    <div class="pt-meta-row"><span class="pt-meta-label">Département</span><span class="pt-meta-separator">:</span><strong class="pt-meta-value" t-field="o.employee_id.department_id"/></div>
                                    <div class="pt-meta-row"><span class="pt-meta-label">Ancienneté</span><span class="pt-meta-separator">:</span><span class="pt-meta-value" t-field="o.contract_id.date_start"/></div>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <table class="pt-lines">
                    <thead>
                        <tr>
                            <th class="pt-code" rowspan="2">Élément</th>
                            <th class="pt-name" rowspan="2">Désignation</th>
                            <th class="pt-base" rowspan="2">Base</th>
                            <th colspan="3">Part salariale</th>
                            <th colspan="2">Part patronale</th>
                        </tr>
                        <tr>
                            <th class="pt-rate">Taux</th>
                            <th class="pt-value">Gain</th>
                            <th class="pt-value">Retenue</th>
                            <th class="pt-rate">Taux</th>
                            <th class="pt-value">Montant</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="structure_groups" t-as="group">
                            <t t-foreach="group['items']" t-as="item">
                                <t t-set="line" t-value="item['line']"/>
                                <tr t-att-class="'pt-summary-line' if item['kind'] == 'summary' else ''">
                                    <td><span t-field="line.code"/></td>
                                    <td><span t-field="line.name"/></td>
                                    <td class="pt-number"><span t-esc="abs(line.amount)" t-options='{"widget": "float", "precision": 2}'/></td>
                                    <td class="pt-number"><span t-if="item['kind'] in ('gain', 'deduction', 'summary')" t-esc="abs(line.rate)" t-options='{"widget": "float", "precision": 2}'/></td>
                                    <td class="pt-number"><span t-if="item['kind'] in ('gain', 'summary')" t-esc="abs(line.total)" t-options='{"widget": "monetary", "display_currency": o.company_id.currency_id}'/></td>
                                    <td class="pt-number"><span t-if="item['kind'] == 'deduction'" t-esc="abs(line.total)" t-options='{"widget": "monetary", "display_currency": o.company_id.currency_id}'/></td>
                                    <td class="pt-number"><span t-if="item['kind'] == 'employer'" t-esc="abs(line.rate)" t-options='{"widget": "float", "precision": 2}'/></td>
                                    <td class="pt-number"><span t-if="item['kind'] == 'employer'" t-esc="abs(line.total)" t-options='{"widget": "monetary", "display_currency": o.company_id.currency_id}'/></td>
                                </tr>
                            </t>
                            <tr class="pt-structure-subtotal">
                                <td colspan="4">SOUS-TOTAL · <span t-esc="group['name']"/></td>
                                <td class="pt-number"><span t-if="group['gain_total']" t-esc="group['gain_total']" t-options='{"widget": "monetary", "display_currency": o.company_id.currency_id}'/></td>
                                <td class="pt-number"><span t-if="group['deduction_total']" t-esc="group['deduction_total']" t-options='{"widget": "monetary", "display_currency": o.company_id.currency_id}'/></td>
                                <td></td>
                                <td class="pt-number"><span t-if="group['employer_total']" t-esc="group['employer_total']" t-options='{"widget": "monetary", "display_currency": o.company_id.currency_id}'/></td>
                            </tr>
                        </t>
                        <tr t-if="not structure_groups">
                            <td colspan="8" style="padding: 16px; text-align: center;">Aucune ligne salariale à afficher.</td>
                        </tr>
                    </tbody>
                </table>

                <table class="pt-totals">
                    <tr>
                        <td><small>Salaire brut et gains</small><strong t-esc="gross_total" t-options='{"widget": "monetary", "display_currency": o.company_id.currency_id}'/></td>
                        <td><small>Retenues salariales</small><strong t-esc="deduction_total" t-options='{"widget": "monetary", "display_currency": o.company_id.currency_id}'/></td>
                        <td><small>Charges patronales</small><strong t-esc="employer_total" t-options='{"widget": "monetary", "display_currency": o.company_id.currency_id}'/></td>
                        <td class="pt-net"><small>NET À PAYER</small><strong t-esc="net_total" t-options='{"widget": "monetary", "display_currency": o.company_id.currency_id}'/></td>
                    </tr>
                </table>

                <div class="pt-note" t-if="o.note">
                    <strong>Observations :</strong> <span t-field="o.note"/>
                </div>
            </div>
        </t>
    </template>

    <template id="report_payslip">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="payroll.payslip_professional_document"/>
            </t>
        </t>
    </template>
</odoo>
