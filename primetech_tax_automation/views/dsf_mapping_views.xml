<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dsf_mapping_list" model="ir.ui.view">
        <field name="name">primetech.dsf.mapping.list</field>
        <field name="model">primetech.dsf.mapping</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="sheet_name"/>
                <field name="cell_address"/>
                <field name="account_ids" widget="many2many_tags"/>
                <field name="amount_type"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="view_dsf_mapping_form" model="ir.ui.view">
        <field name="name">primetech.dsf.mapping.form</field>
        <field name="model">primetech.dsf.mapping</field>
        <field name="arch" type="xml">
            <form string="Correspondance DSF">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="company_id"/>
                        <field name="sheet_name"/>
                        <field name="template_cell_id" widget="selection" options="{'no_create': True, 'no_open': True}"/>
                        <field name="cell_address" invisible="1"/>
                        <field name="account_ids" widget="many2many_tags" options="{'no_create_edit': True}"/>
                        <field name="amount_type"/>
                        <field name="multiplier"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_dsf_mapping" model="ir.actions.act_window">
        <field name="name">Correspondances DSF</field>
        <field name="res_model">primetech.dsf.mapping</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_dsf_generation" name="Générer la DSF" parent="menu_tax_root" action="action_dsf_generation_wizard" sequence="20" groups="primetech_tax_automation.group_tax_preparer"/>
    <menuitem id="menu_dsf_mapping" name="Correspondances DSF" parent="menu_tax_configuration" action="action_dsf_mapping" sequence="20" groups="primetech_tax_automation.group_tax_preparer"/>
</odoo>
