<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dsf_generation_wizard_form" model="ir.ui.view">
        <field name="name">primetech.dsf.generation.wizard.form</field>
        <field name="model">primetech.dsf.generation.wizard</field>
        <field name="arch" type="xml">
            <form string="Générer la DSF DGI">
                <group>
                    <field name="company_id"/>
                    <field name="fiscal_year_date" widget="primetech_fiscal_year"
                           options="{'min_precision': 'years', 'max_precision': 'years'}"/>
                </group>
                <p class="text-muted">Le classeur officiel DSF système normal est conservé à l'identique. Les informations de la société et les cellules configurées dans les Correspondances DSF sont alimentées à partir de la comptabilité validée.</p>
                <footer>
                    <button name="action_generate_dsf" type="object" string="Générer le fichier XLSX" class="btn-primary"/>
                    <button string="Annuler" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_dsf_generation_wizard" model="ir.actions.act_window">
        <field name="name">Générer la DSF</field>
        <field name="res_model">primetech.dsf.generation.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
