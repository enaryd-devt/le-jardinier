<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="hr_payroll_dipe_view_form" model="ir.ui.view">
        <field name="name">hr.payroll.dipe.form</field>
        <field name="model">hr.payroll.dipe</field>
        <field name="arch" type="xml">
            <form string="Generate DIPE">
                <sheet>
                    <group>
                        <group>
                            <field name="period_id"
                                   required="1"
                                   domain="[('state', '=', 'draft')]"/>
                        </group>

                        <!-- Download section -->
                        <group string="Télécharger le fichier"
                               invisible="state != 'get'">
                            <field name="state" invisible="1"/>
                            <field name="fname" invisible="1"/>
                            <field name="data"
                                   filename="fname"
                                   nolabel="1"/>
                        </group>
                    </group>
                </sheet>

                <footer>
                    <button name="get_payroll_dipe"
                            string="Exporter le fichier"
                            type="object"
                            class="btn-primary"/>

                    <button string="Annuler"
                            special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Wizard Action -->
    <record id="action_view_wizard_payroll_dipe" model="ir.actions.act_window">
        <field name="name">Exporter la DIPE</field>
        <field name="res_model">hr.payroll.dipe</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="hr_payroll_dipe_view_form"/>
        <field name="target">new</field>
    </record>
</odoo>
