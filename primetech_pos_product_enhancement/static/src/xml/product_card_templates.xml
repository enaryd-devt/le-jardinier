<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
  <t t-inherit="point_of_sale.ProductCard" t-inherit-mode="extension" owl="1">
    <xpath expr="//article" position="attributes">
      <attribute name="t-on-click">onProductClick</attribute>
      <attribute name="t-on-keypress">onProductKeypress</attribute>
      <attribute name="t-att-class">{
        'pt-product-stock-empty': isStockEmpty,
        'pt-product-unavailable': isOutOfStock,
      }</attribute>
    </xpath>
    <xpath expr="//div[contains(@class, 'product-information-tag')]" position="attributes">
      <attribute name="title">Informations du produit</attribute>
    </xpath>
    <xpath expr="//article" position="inside">
      <div t-if="isStockTracked" class="pt-stock-badge" t-att-class="stockClass">
        <i class="fa fa-cubes"/>
        <span><t t-esc="formattedWarehouseQty"/></span>
      </div>
      <div class="pt-price-badge">
        <i class="fa fa-tag"/>
        <span class="pt-price-text" t-esc="formattedSalesPrice"/>
      </div>
    </xpath>
  </t>
</templates>
