<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_mass_bank_reconcile" model="ir.module.category">
        <field name="name">Mass Bank Reconciliation</field>
        <field name="sequence">35</field>
    </record>
    <record id="group_mass_bank_reconcile_user" model="res.groups">
        <field name="name">Mass Bank Reconciliation User</field>
        <field name="category_id" ref="module_category_mass_bank_reconcile"/>
        <field name="implied_ids" eval="[(4, ref('account.group_account_user'))]"/>
    </record>
    <record id="group_mass_bank_reconcile_manager" model="res.groups">
        <field name="name">Mass Bank Reconciliation Manager</field>
        <field name="category_id" ref="module_category_mass_bank_reconcile"/>
        <field name="implied_ids" eval="[(4, ref('group_mass_bank_reconcile_user'))]"/>
    </record>
    <record id="mass_bank_reconcile_log_company_rule" model="ir.rule">
        <field name="name">Mass reconciliation logs by company</field>
        <field name="model_id" ref="model_primetech_mass_bank_reconcile_log"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_mass_bank_reconcile_user'))]"/>
    </record>
</odoo>
