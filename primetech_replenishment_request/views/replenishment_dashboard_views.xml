<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_replenishment_dashboard_form" model="ir.ui.view">
        <field name="name">replenishment.dashboard.form</field>
        <field name="model">replenishment.dashboard</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <sheet>
                    <div class="container-fluid p-0">
                        <div class="rounded-4 shadow-sm p-4 mb-4 text-white" style="background: linear-gradient(135deg, #171846 0%, #4b2bc1 58%, #20a7e8 100%);">
                            <div class="d-flex align-items-center gap-3 mb-2">
                                <span class="rounded-circle bg-white text-primary d-inline-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                                    <i class="bi bi-speedometer2 fs-3"/>
                                </span>
                                <div>
                                    <span class="badge rounded-pill bg-light text-primary mb-2">PrimeTech Inventory Suite</span>
                                    <h1 class="mb-0 fw-bold">Tableau de bord du réapprovisionnement</h1>
                                </div>
                            </div>
                            <p class="mb-0 opacity-75">Suivez les demandes internes, les validations et les transferts avec des indicateurs clairs et professionnels.</p>
                        </div>
                        <div class="row g-3 o_replenishment_dashboard">
                            <div class="col-12 col-md-6 col-xl-4">
                                <div class="card h-100 border-0 shadow-sm rounded-4">
                                    <div class="card-body">
                                        <div class="d-flex justify-content-between align-items-start">
                                            <div><span class="text-muted fw-semibold">Total</span><h2 class="display-6 fw-bold mb-0"><field name="total_count" nolabel="1"/></h2><small class="text-muted">Demandes créées</small></div>
                                            <i class="bi bi-clipboard-data text-primary fs-2"/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-12 col-md-6 col-xl-4">
                                <div class="card h-100 border-0 shadow-sm rounded-4">
                                    <div class="card-body">
                                        <div class="d-flex justify-content-between align-items-start">
                                            <div><span class="text-muted fw-semibold">Brouillons</span><h2 class="display-6 fw-bold mb-0"><field name="draft_count" nolabel="1"/></h2><small class="text-muted">À compléter</small></div>
                                            <i class="bi bi-pencil-square text-secondary fs-2"/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-12 col-md-6 col-xl-4">
                                <div class="card h-100 border-0 shadow-sm rounded-4">
                                    <div class="card-body">
                                        <div class="d-flex justify-content-between align-items-start">
                                            <div><span class="text-muted fw-semibold">À approuver</span><h2 class="display-6 fw-bold mb-0"><field name="to_approve_count" nolabel="1"/></h2><small class="text-muted">En attente de décision</small></div>
                                            <i class="bi bi-hourglass-split text-warning fs-2"/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-12 col-md-6 col-xl-4">
                                <div class="card h-100 border-0 shadow-sm rounded-4">
                                    <div class="card-body">
                                        <div class="d-flex justify-content-between align-items-start">
                                            <div><span class="text-muted fw-semibold">Approuvées</span><h2 class="display-6 fw-bold mb-0"><field name="approved_count" nolabel="1"/></h2><small class="text-muted">Transferts générés</small></div>
                                            <i class="bi bi-check2-circle text-success fs-2"/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-12 col-md-6 col-xl-4">
                                <div class="card h-100 border-0 shadow-sm rounded-4">
                                    <div class="card-body">
                                        <div class="d-flex justify-content-between align-items-start">
                                            <div><span class="text-muted fw-semibold">Annulées</span><h2 class="display-6 fw-bold mb-0"><field name="cancelled_count" nolabel="1"/></h2><small class="text-muted">Demandes clôturées</small></div>
                                            <i class="bi bi-x-octagon text-danger fs-2"/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-12 col-md-6 col-xl-4">
                                <div class="card h-100 border-0 shadow-sm rounded-4">
                                    <div class="card-body">
                                        <div class="d-flex justify-content-between align-items-start">
                                            <div><span class="text-muted fw-semibold">Transferts</span><h2 class="display-6 fw-bold mb-0"><field name="picking_count" nolabel="1"/></h2><small class="text-muted">Mouvements internes</small></div>
                                            <i class="bi bi-truck text-info fs-2"/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_replenishment_dashboard" model="ir.actions.act_window">
        <field name="name">Tableau de bord</field>
        <field name="res_model">replenishment.dashboard</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="res_id">1</field>
    </record>
</odoo>
