<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
  <t t-name="primetech_reporting_center.SalesOverviewDashboard" owl="1">
    <main class="pt-sales-overview pt-sales-v2">
      <t t-if="!state.loaded"><div class="pt-sales-loading"><i class="fa fa-spinner fa-spin fa-3x"/> Chargement du tableau de bord…</div></t>
      <t t-else="">
        <header class="pt-a2-header">
          <div class="pt-a2-title"><span class="pt-a2-title-icon"><i class="fa fa-shopping-cart"/></span><div><h1>Tableau de bord – Ventes</h1><p>Vue d’ensemble de l’activité commerciale et de la facturation client</p></div></div>
          <div class="pt-a2-filters">
            <label class="pt-a2-filter-label pt-a2-period-control">Période
              <select t-model="state.period" t-on-change="onGlobalPeriodChange"><option value="today">Aujourd'hui</option><option value="week">Cette semaine</option><option value="month">Ce mois</option><option value="quarter">Ce trimestre</option><option value="year">Cette année</option><option value="custom">Période</option></select>
            </label>
            <t t-if="state.period === 'custom'"><label class="pt-a2-filter-label">Du <input type="date" t-model="state.dateFrom" t-on-change="(ev) => this.onGlobalDateChange('dateFrom', ev)"/></label><label class="pt-a2-filter-label">Au <input type="date" t-model="state.dateTo" t-on-change="(ev) => this.onGlobalDateChange('dateTo', ev)"/></label></t>
          </div>
        </header>

        <section class="pt-a2-kpis pt-sales-kpis-v2">
          <button class="tone-green" t-on-click="() => this.openInvoices()"><i class="fa fa-bar-chart"/><span>Chiffre d’affaires</span><strong><t t-esc="money(state.data.turnover_ht)"/></strong><em><t t-esc="pct(state.data.growth_rate)"/></em></button>
          <button class="tone-blue" t-on-click="() => this.openOrders([['state','in',['sale','done']]])"><i class="fa fa-shopping-cart"/><span>Commandes confirmées</span><strong><t t-esc="state.data.confirmed_order_count"/></strong><em><t t-esc="pct(state.data.conversion_growth)"/></em></button>
          <button class="tone-purple" t-on-click="() => this.openOrders()"><i class="fa fa-database"/><span>Montant moyen / commande</span><strong><t t-esc="money(state.data.average_ticket)"/></strong><em><t t-esc="pct(state.data.average_ticket_growth)"/></em></button>
          <button class="tone-orange" t-on-click="() => this.openInvoices()"><i class="fa fa-cube"/><span>Quantité vendue</span><strong><t t-esc="Math.round(state.data.quantity_sold || 0)"/></strong><em><t t-esc="pct(state.data.quantity_sold_growth)"/></em></button>
          <button class="tone-emerald" t-on-click="() => this.openInvoices()"><i class="fa fa-percent"/><span>Marge brute</span><strong><t t-esc="money(state.data.margin_amount)"/></strong><em><t t-esc="pct(state.data.margin_rate)"/></em></button>
          <button class="tone-rose" t-on-click="() => this.openOrders([['state','in',['draft','sent']]])"><i class="fa fa-file-text-o"/><span>Devis en attente</span><strong><t t-esc="state.data.pipeline.draft + state.data.pipeline.sent"/></strong><em><t t-esc="state.data.pipeline.expired"/> expirés</em></button>
          <button class="tone-yellow" t-on-click="() => this.openOrders([['state','in',['sale','done']]])"><i class="fa fa-line-chart"/><span>Taux de conversion</span><strong><t t-esc="pct(state.data.conversion_rate)"/></strong><em><t t-esc="pct(state.data.conversion_growth)"/></em></button>
          <button class="tone-cyan" t-on-click="() => this.openPartners()"><i class="fa fa-users"/><span>Clients actifs</span><strong><t t-esc="state.data.customer_count"/></strong><em><t t-esc="pct(state.data.customer_growth)"/></em></button>
          <button class="tone-indigo" t-on-click="() => this.openPartners()"><i class="fa fa-user-plus"/><span>Nouveaux clients</span><strong><t t-esc="state.data.new_customer_count"/></strong><em><t t-esc="pct(state.data.new_customer_growth)"/></em></button>
          <button class="tone-red" t-on-click="() => this.openInvoices([['move_type','=','out_refund']])"><i class="fa fa-undo"/><span>Avoirs / retours</span><strong><t t-esc="money(state.data.refund_amount)"/></strong><em><t t-esc="state.data.refund_count"/> documents</em></button>
        </section>

        <section class="pt-a2-charts pt-sales-charts-v2"><article><h3><i class="fa fa-line-chart"/> Évolution du chiffre d’affaires et de la marge</h3><canvas id="salesEvolutionChart"/></article><article><h3><i class="fa fa-bar-chart"/> Nombre de commandes</h3><canvas id="salesOrderChart"/></article><article><h3><i class="fa fa-pie-chart"/> Ventes par catégorie de produits</h3><canvas id="salesCategoryChart"/></article><article><h3><i class="fa fa-pie-chart"/> Ventes par canal</h3><canvas id="salesChannelChart"/></article></section>

        <section class="pt-sales-tables-v2">
          <article><h3>Top produits vendus <button t-on-click="() => this.openProducts()">Voir tout</button></h3><div class="pt-sales-scroll"><table><thead><tr><th>Produit</th><th>Quantité</th><th>CA</th></tr></thead><tbody><tr t-foreach="state.data.top_products || []" t-as="row" t-key="row.id" t-on-click="() => this.openProducts([row.id])"><td><t t-esc="row.name"/></td><td><t t-esc="Math.round(row.qty)"/></td><td><t t-esc="money(row.amount)"/></td></tr></tbody></table></div></article>
          <article><h3>Top clients <button t-on-click="() => this.openPartners()">Voir tout</button></h3><div class="pt-sales-scroll"><table><thead><tr><th>Client</th><th>CA</th><th>%</th></tr></thead><tbody><tr t-foreach="state.data.top_customers || []" t-as="row" t-key="row.id" t-on-click="() => this.openPartners([row.id])"><td><t t-esc="row.name"/></td><td><t t-esc="money(row.amount)"/></td><td><t t-esc="pct(row.growth)"/></td></tr></tbody></table></div></article>
          <article><h3>Performance des commerciaux <button t-on-click="() => this.openSalespersons()">Voir tout</button></h3><div class="pt-sales-scroll"><table><thead><tr><th>Commercial</th><th>CA</th><th>Objectif</th><th>Réalisation</th></tr></thead><tbody><tr t-foreach="state.data.top_salespersons || []" t-as="row" t-key="row.id" t-on-click="() => this.openSalespersons([row.id])"><td><t t-esc="row.name"/></td><td><t t-esc="money(row.amount)"/></td><td><t t-esc="money(row.target)"/></td><td><t t-esc="pct(row.realization)"/></td></tr></tbody></table></div></article>
        </section>

        <section class="pt-sales-bottom-v2">
          <article><h3><i class="fa fa-list-alt"/> Dernières commandes <button t-on-click="() => this.openOrders()">Voir tout</button></h3><div class="pt-sales-scroll"><table><thead><tr><th>Date</th><th>Référence</th><th>Client</th><th>Statut</th><th>Montant</th></tr></thead><tbody><tr t-foreach="state.data.last_orders || []" t-as="row" t-key="row.id" t-on-click="() => this.openOrders([['id','=',row.id]])"><td><t t-esc="row.date"/></td><td><t t-esc="row.name"/></td><td><t t-esc="row.customer"/></td><td><t t-esc="row.state"/></td><td><t t-esc="money(row.amount)"/></td></tr></tbody></table></div></article>
          <article><h3><i class="fa fa-file-text-o"/> Synthèse des devis</h3><div class="pt-sales-summary"><button t-on-click="() => this.openOrders([['state','=','draft']])"><span>Brouillons</span><strong><t t-esc="state.data.pipeline.draft"/></strong></button><button t-on-click="() => this.openOrders([['state','=','sent']])"><span>Envoyés</span><strong><t t-esc="state.data.pipeline.sent"/></strong></button><button t-on-click="() => this.openOrders([['state','in',['sale','done']]])"><span>Confirmés</span><strong><t t-esc="state.data.pipeline.confirmed"/></strong></button><button t-on-click="() => this.openOrders([['validity_date','&lt;',state.data.today],['state','in',['draft','sent']]])"><span>Expirés</span><strong><t t-esc="state.data.pipeline.expired"/></strong></button></div></article>
          <article class="pt-sales-reports"><h3><i class="fa fa-print"/> Rapports de ventes</h3><div class="pt-a2-financial"><button t-on-click="() => this.openReport('action_sales_periodic_report')"><i class="fa fa-calendar"/> Rapport périodique</button><button t-on-click="() => this.openReport('action_sales_customer_analysis_report')"><i class="fa fa-users"/> Analyse clients</button><button t-on-click="() => this.openReport('action_sales_product_analysis_report')"><i class="fa fa-cubes"/> Analyse produits</button><button t-on-click="() => this.openReport('action_sales_performance_report_wizard')"><i class="fa fa-line-chart"/> Performance commerciale</button><button t-on-click="() => this.openReport('action_sales_profitability_report_wizard')"><i class="fa fa-percent"/> Rentabilité commerciale</button><button t-on-click="() => this.openReport('action_sales_orders_tracking_report_wizard')"><i class="fa fa-truck"/> Suivi des commandes</button><button t-on-click="() => this.openReport('action_invoice_analysis_report_wizard')"><i class="fa fa-file-text-o"/> Analyse de facturation</button></div></article>
        </section>
      </t>
    </main>
  </t>
</templates>
