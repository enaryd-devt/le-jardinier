<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve"><t t-name="primetech_reporting_center.StockDashboard" owl="1"><main class="pt-stock-overview pt-stock-v2"><t t-if="state.loading"><div class="pt-stock-loading"><i class="fa fa-spinner fa-spin fa-3x"/> Chargement du tableau de bord…</div></t><t t-else=""><header class="pt-a2-header"><div class="pt-a2-title"><span class="pt-a2-title-icon"><i class="fa fa-cubes"/></span><div><h1>Tableau de bord – Gestion des stocks</h1><p>Vue d’ensemble des mouvements et de la situation des stocks</p></div></div><div class="pt-a2-filters"><label class="pt-a2-filter-label pt-a2-period-control">Période<select t-model="state.period" t-on-change="onGlobalPeriodChange"><option value="today">Aujourd'hui</option><option value="week">Cette semaine</option><option value="month">Ce mois</option><option value="quarter">Ce trimestre</option><option value="year">Cette année</option><option value="custom">Période</option></select></label><t t-if="state.period === 'custom'"><label class="pt-a2-filter-label">Du <input type="date" t-model="state.dateFrom" t-on-change="(ev) => this.onGlobalDateChange('dateFrom', ev)"/></label><label class="pt-a2-filter-label">Au <input type="date" t-model="state.dateTo" t-on-change="(ev) => this.onGlobalDateChange('dateTo', ev)"/></label></t></div></header>
<section class="pt-a2-kpis"><button class="tone-blue" t-on-click="() => this.openProducts()"><i class="fa fa-cubes"/><span>Valeur totale du stock</span><strong><t t-esc="money(state.data.stock_value)"/></strong><em><t t-esc="pct(state.data.stock_value_growth)"/></em></button><button class="tone-emerald" t-on-click="() => this.openProducts([['qty_available','&gt;',0]])"><i class="fa fa-cube"/><span>Quantité totale en stock</span><strong><t t-esc="Math.round(state.data.stock_qty)"/></strong><em><t t-esc="pct(state.data.available_growth)"/></em></button><button class="tone-purple" t-on-click="() => this.openMoves([['picking_type_id.code','=','incoming']])"><i class="fa fa-sign-in"/><span>Entrées en stock</span><strong><t t-esc="Math.round(state.data.incoming_qty)"/></strong><em>période sélectionnée</em></button><button class="tone-orange" t-on-click="() => this.openMoves([['picking_type_id.code','=','outgoing']])"><i class="fa fa-sign-out"/><span>Sorties de stock</span><strong><t t-esc="Math.round(state.data.outgoing_qty)"/></strong><em>période sélectionnée</em></button><button class="tone-red" t-on-click="() => this.openProducts([['qty_available','&lt;=',0]])"><i class="fa fa-exclamation-triangle"/><span>Produits en rupture</span><strong><t t-esc="state.data.out_of_stock"/></strong><em><t t-esc="pct(state.data.out_of_stock_growth)"/></em></button><button class="tone-yellow" t-on-click="() => this.openProducts([['id','in',state.data.below_min_product_ids]])"><i class="fa fa-warning"/><span>Produits sous stock mini</span><strong><t t-esc="state.data.below_min"/></strong><em><t t-esc="pct(state.data.below_min_growth)"/></em></button><button class="tone-cyan" t-on-click="() => this.openProducts()"><i class="fa fa-calendar"/><span>Produits proches d’expiration</span><strong><t t-esc="state.data.alerts.soon_expiring_lots"/></strong><em>à surveiller</em></button><button class="tone-rose" t-on-click="() => this.openMoves()"><i class="fa fa-random"/><span>Mouvements de stock</span><strong><t t-esc="state.data.moves_count"/></strong><em>période sélectionnée</em></button><button class="tone-indigo" t-on-click="() => this.openLocations()"><i class="fa fa-map-marker"/><span>Nombre d’emplacements</span><strong><t t-esc="state.data.locations_count"/></strong><em>internes</em></button><button class="tone-teal" t-on-click="() => this.openProducts()"><i class="fa fa-th"/><span>Produits actifs</span><strong><t t-esc="state.data.products_count"/></strong><em>en stock</em></button></section>
<section class="pt-stock-charts"><article><h3><i class="fa fa-bar-chart"/> Évolution des entrées et sorties</h3><canvas id="stockMovementsChart"/></article><article><h3><i class="fa fa-pie-chart"/> Répartition du stock par catégorie</h3><canvas id="stockCategoryChart"/></article><article><h3><i class="fa fa-bar-chart"/> Valeur du stock par emplacement</h3><canvas id="stockWarehouseChart"/></article><article><h3><i class="fa fa-line-chart"/> Évolution de la valeur du stock</h3><canvas id="stockValueChart"/></article></section>
<section class="pt-stock-tables"><article><h3>Produits en rupture de stock <button t-on-click="() => this.openProducts([['qty_available','&lt;=',0]])">Voir tout</button></h3><div class="pt-stock-scroll"><table><thead><tr><th>Produit</th><th>Référence</th><th>Emplacement</th><th>Qté</th></tr></thead><tbody><tr t-foreach="state.data.shortage_products || []" t-as="row" t-key="row.id" t-on-click="() => this.openProducts([['id','=',row.id]])"><td><t t-esc="row.name"/></td><td><t t-esc="row.reference"/></td><td><t t-esc="row.location"/></td><td><t t-esc="row.qty"/></td></tr></tbody></table></div></article><article><h3>Produits sous stock minimum <button t-on-click="() => this.openProducts([['id','in',state.data.below_min_product_ids]])">Voir tout</button></h3><div class="pt-stock-scroll"><table><thead><tr><th>Produit</th><th>Emplacement</th><th>Qté suggérée</th><th>Priorité</th></tr></thead><tbody><tr t-foreach="state.data.replenishments || []" t-as="row" t-key="row.id" t-on-click="() => this.openProducts([['id','=',row.product_id]])"><td><t t-esc="row.product"/></td><td><t t-esc="row.location"/></td><td><t t-esc="row.qty"/></td><td><t t-esc="row.priority"/></td></tr></tbody></table></div></article></section>
<section class="pt-stock-bottom"><article><h3>Top produits en stock <button t-on-click="() => this.openProducts()">Voir tout</button></h3><div class="pt-stock-scroll"><table><thead><tr><th>Produit</th><th>Quantité</th><th>Valeur</th></tr></thead><tbody><tr t-foreach="state.data.top_stock_products || []" t-as="row" t-key="row.id" t-on-click="() => this.openProducts([['id','=',row.id]])"><td><t t-esc="row.name"/></td><td><t t-esc="row.qty"/></td><td><t t-esc="money(row.value)"/></td></tr></tbody></table></div></article><article><h3>Mouvements récents de stock <button t-on-click="() => this.openMoves()">Voir tout</button></h3><div class="pt-stock-scroll"><table><thead><tr><th>Date</th><th>Produit</th><th>Type</th><th>Qté</th></tr></thead><tbody><tr t-foreach="state.data.recent_moves || []" t-as="row" t-key="row.id" t-on-click="() => this.openMoves([['id','=',row.id]])"><td><t t-esc="row.date"/></td><td><t t-esc="row.product"/></td><td><t t-esc="row.type"/></td><td><t t-esc="row.qty"/></td></tr></tbody></table></div></article><article><h3><i class="fa fa-print"/> Rapports de stock</h3><div class="pt-a2-financial"><button t-on-click="() => this.openReport('primetech_reporting_center.action_stock_status_wizard')">État du stock</button><button t-on-click="() => this.openReport('primetech_reporting_center.action_stock_card_wizard')">Fiche de stock</button><button t-on-click="() => this.openReport('primetech_reporting_center.action_stock_inventory_wizard')">Inventaire</button><button t-on-click="() => this.openReport('primetech_reporting_center.action_stock_valuation_wizard')">Valorisation du stock</button><button t-on-click="() => this.openReport('primetech_reporting_center.action_stock_movement_wizard')">Mouvements de stock</button></div></article></section>
</t></main></t></templates>
