<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
  <t t-name="primetech_reporting_center.AccountingDashboard" owl="1">
    <main class="pt-accounting-overview pt-accounting-v2">
      <t t-if="state.loading"><div class="pt-accounting-loading"><i class="fa fa-spinner fa-spin fa-3x"/> Chargement…</div></t>
      <t t-else="">
        <header class="pt-a2-header">
          <div class="pt-a2-title"><span class="pt-a2-title-icon"><i class="fa fa-bar-chart"/></span><div><h1>Tableau de bord – Comptabilité</h1><p>Vue d’ensemble de la situation financière de l’entreprise</p></div></div>
          <div class="pt-a2-filters"><select t-att-value="state.filters.company_id" t-on-change="onCompanyChange"><option value="">Toutes les sociétés</option><t t-foreach="state.data.filters.companies || []" t-as="company" t-key="company.id"><option t-att-value="company.id"><t t-esc="company.name"/></option></t></select><div class="pt-a2-periods"><button t-foreach="state.data.filters.periods || []" t-as="period" t-key="period.value" t-att-class="state.filters.period === period.value ? 'active' : ''" t-on-click="() => this.selectPeriod(period.value)"><t t-esc="period.label"/></button></div><input type="date" t-att-value="state.dateFilter.dateFrom" t-on-change="(ev) => this.onGlobalDateChange('dateFrom', ev)"/><input type="date" t-att-value="state.dateFilter.dateTo" t-on-change="(ev) => this.onGlobalDateChange('dateTo', ev)"/></div>
        </header>
        <section class="pt-a2-kpis">
          <button class="tone-green" t-on-click="() => this.openInvoices()"><i class="fa fa-bar-chart"/><span>Chiffre d’affaires</span><strong><t t-esc="money(state.data.revenue.value)"/></strong><em><t t-esc="pct(state.data.revenue.variation)"/></em></button>
          <button class="tone-emerald" t-on-click="() => this.openJournalItems()"><i class="fa fa-line-chart"/><span>Résultat net</span><strong><t t-esc="money(state.data.net_result)"/></strong><em><t t-esc="pct(state.data.net_result_growth)"/></em></button>
          <button class="tone-blue" t-on-click="() => this.openInvoices([['payment_state','!=','paid']])"><i class="fa fa-users"/><span>Créances clients</span><strong><t t-esc="money(state.data.receivables)"/></strong><em><t t-esc="pct(state.data.receivables_growth)"/></em></button>
          <button class="tone-orange" t-on-click="() => this.openBills([['payment_state','!=','paid']])"><i class="fa fa-shopping-cart"/><span>Dettes fournisseurs</span><strong><t t-esc="money(state.data.payables)"/></strong><em><t t-esc="pct(state.data.payables_growth)"/></em></button>
          <button class="tone-purple" t-on-click="() => this.openAccounts()"><i class="fa fa-wallet"/><span>Trésorerie disponible</span><strong><t t-esc="money(state.data.cash)"/></strong><em><t t-esc="pct(state.data.cash_growth)"/></em></button>
          <button class="tone-cyan" t-on-click="() => this.openInvoices([['payment_state','in',['paid','in_payment']]])"><i class="fa fa-download"/><span>Encaissements</span><strong><t t-esc="money(state.data.cashflow.incoming)"/></strong></button>
          <button class="tone-red" t-on-click="() => this.openBills([['payment_state','in',['paid','in_payment']]])"><i class="fa fa-upload"/><span>Décaissements</span><strong><t t-esc="money(state.data.cashflow.outgoing)"/></strong></button>
          <button class="tone-rose" t-on-click="() => this.openInvoices([['invoice_date_due','&lt;',state.data.today],['payment_state','!=','paid']])"><i class="fa fa-exclamation-circle"/><span>Factures clients échues</span><strong><t t-esc="money(state.data.overdue_amount)"/></strong><em class="danger"><t t-esc="state.data.overdue_count"/> factures</em></button>
          <button class="tone-teal" t-on-click="() => this.openAccounts()"><i class="fa fa-bank"/><span>Solde bancaire</span><strong><t t-esc="money(state.data.cash)"/></strong></button>
          <button class="tone-yellow" t-on-click="() => this.openJournalItems()"><i class="fa fa-percent"/><span>Impôts &amp; taxes à payer</span><strong><t t-esc="money(state.data.tax_due)"/></strong></button>
        </section>
        <section class="pt-a2-charts"><article><h3><i class="fa fa-users"/> Chiffre d’affaires vs charges</h3><canvas id="accountingRevenueChart"/></article><article><h3><i class="fa fa-exchange"/> Encaissements vs décaissements</h3><canvas id="accountingFlowChart"/></article><article><h3><i class="fa fa-pie-chart"/> Répartition des charges</h3><canvas id="accountingExpenseChart"/></article><article><h3><i class="fa fa-line-chart"/> Évolution de la trésorerie</h3><canvas id="accountingTreasuryChart"/></article></section>
        <section class="pt-a2-tables"><article><h3>Balance âgée des clients <button t-on-click="() => this.openInvoices([['payment_state','!=','paid']])">Voir tout</button></h3><table><thead><tr><th>Période</th><th>Montant</th><th>%</th></tr></thead><tbody><tr t-foreach="state.data.receivable_aging || []" t-as="row" t-key="row.label" t-on-click="() => this.openInvoices(row.domain)"><td><t t-esc="row.label"/></td><td><t t-esc="money(row.amount)"/></td><td><span class="pt-a2-bar"><b t-att-style="'width:'+row.percent+'%'"/></span><t t-esc="pct(row.percent)"/></td></tr></tbody></table></article><article><h3>Balance âgée des fournisseurs <button t-on-click="() => this.openBills([['payment_state','!=','paid']])">Voir tout</button></h3><table><thead><tr><th>Période</th><th>Montant</th><th>%</th></tr></thead><tbody><tr t-foreach="state.data.payable_aging || []" t-as="row" t-key="row.label" t-on-click="() => this.openBills(row.domain)"><td><t t-esc="row.label"/></td><td><t t-esc="money(row.amount)"/></td><td><span class="pt-a2-bar"><b t-att-style="'width:'+row.percent+'%'"/></span><t t-esc="pct(row.percent)"/></td></tr></tbody></table></article></section>
        <section class="pt-a2-bottom"><article><h3><i class="fa fa-percent"/> Synthèse fiscale</h3><button t-on-click="() => this.openJournalItems()">Résultat comptable <strong><t t-esc="money(state.data.net_result)"/></strong></button><button t-on-click="() => this.openJournalItems()">Charges de la période <strong><t t-esc="money(state.data.expenses)"/></strong></button><button t-on-click="() => this.openJournalItems()">Impôts et taxes à payer <strong><t t-esc="money(state.data.tax_due)"/></strong></button></article><article><h3><i class="fa fa-bank"/> Situation de trésorerie</h3><button t-foreach="state.data.cash_accounts || []" t-as="account" t-key="account.id" t-on-click="() => this.openAccounts([['id','=',account.id]])"><t t-esc="account.name"/><strong><t t-esc="money(account.amount)"/></strong></button></article><article><h3><i class="fa fa-file-text"/> États financiers</h3><div class="pt-a2-financial"><button t-on-click="openTrialBalance"><i class="fa fa-balance-scale"/> Balance générale</button><button t-on-click="openTrialBalance"><i class="fa fa-line-chart"/> Compte de résultat</button><button t-on-click="openTrialBalance"><i class="fa fa-exchange"/> Flux de trésorerie</button><button t-on-click="openTrialBalance"><i class="fa fa-book"/> Grand livre</button></div></article></section>
      </t>
    </main>
  </t>
</templates>
