<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
  <t t-name="primetech_reporting_center.HROverviewDashboard" owl="1">
    <main class="pt-hr-dashboard pt-hr-v2">
      <t t-if="state.loading"><div class="pt-hr-loading"><i class="fa fa-spinner fa-spin fa-3x"/>Chargement des données RH…</div></t>
      <t t-else="">
        <header class="pt-hr-v2-header">
          <div class="pt-hr-v2-heading"><span class="pt-hr-v2-heading-icon"><i class="fa fa-users"/></span><div><h1>Tableau de bord – Ressources humaines</h1><p>Vue d'ensemble des effectifs, présences, congés et paie</p></div></div>
          <section class="pt-hr-v2-filters">
            <label>Département<select t-model="state.departmentId" t-on-change="onDepartmentChange"><option value="">Tous les départements</option><t t-foreach="state.departmentOptions" t-as="department" t-key="department.id"><option t-att-value="department.id"><t t-esc="department.name"/></option></t></select></label>
            <label>Période<select t-model="state.period" t-on-change="onGlobalPeriodChange"><option value="today">Aujourd'hui</option><option value="week">Cette semaine</option><option value="month">Ce mois</option><option value="quarter">Ce trimestre</option><option value="year">Cette année</option><option value="custom">Période</option></select></label>
            <t t-if="state.period === 'custom'"><label>Du<input type="date" t-model="state.dateFrom" t-on-change="(ev) => this.onGlobalDateChange('dateFrom', ev)"/></label><label>Au<input type="date" t-model="state.dateTo" t-on-change="(ev) => this.onGlobalDateChange('dateTo', ev)"/></label></t>
          </section>
        </header>

        <section class="pt-hr-v2-kpis">
          <button class="pt-hr-v2-kpi blue" t-on-click="() => this.openEmployees()"><i class="fa fa-users"/><span><b>Effectif total</b><strong><t t-esc="state.data.employees"/></strong><small>Employés actifs : <t t-esc="state.data.active_employees"/></small></span></button>
          <button class="pt-hr-v2-kpi green" t-on-click="() => this.openEmployees([['create_date', '>=', state.data.period_start]])"><i class="fa fa-user-plus"/><span><b>Nouveaux employés</b><strong><t t-esc="state.data.new_hires"/></strong><em><i class="fa fa-arrow-up"/> <t t-esc="pct(state.data.new_hire_growth)"/></em></span></button>
          <button class="pt-hr-v2-kpi purple" t-on-click="() => this.openEmployees([['active', '=', false]])"><i class="fa fa-sign-out"/><span><b>Départs</b><strong><t t-esc="state.data.departures"/></strong><em>Sur la période</em></span></button>
          <button class="pt-hr-v2-kpi orange" t-on-click="() => this.openAttendances()"><i class="fa fa-user-check"/><span><b>Taux de présence</b><strong><t t-esc="pct(state.data.attendance_rate)"/></strong><em><i class="fa fa-arrow-up"/> <t t-esc="pct(state.data.attendance_growth)"/></em></span></button>
          <button class="pt-hr-v2-kpi red" t-on-click="() => this.openEmployees([['id', 'in', state.data.absent_employee_ids]])"><i class="fa fa-calendar-times-o"/><span><b>Taux d'absentéisme</b><strong><t t-esc="pct(state.data.absenteeism_rate)"/></strong><em>Absents : <t t-esc="state.data.absent_today"/></em></span></button>
          <button class="pt-hr-v2-kpi emerald" t-on-click="() => this.openLeaves([['state', '=', 'validate']])"><i class="fa fa-calendar"/><span><b>Congés accordés</b><strong><t t-esc="state.data.leave_validated"/></strong><small>Congés validés</small></span></button>
          <button class="pt-hr-v2-kpi amber" t-on-click="() => this.openAttendances()"><i class="fa fa-clock-o"/><span><b>Pointages incomplets</b><strong><t t-esc="state.data.alerts.incomplete_attendances"/></strong><small>À régulariser</small></span></button>
          <button class="pt-hr-v2-kpi violet" t-on-click="() => this.openPayroll()"><i class="fa fa-money"/><span><b>Masse salariale</b><strong><t t-esc="money(state.data.payroll_mass)"/></strong><em><i class="fa fa-arrow-up"/> <t t-esc="pct(state.data.payroll_growth)"/></em></span></button>
          <button class="pt-hr-v2-kpi cyan" t-on-click="() => this.openContracts([['state', '=', 'open']])"><i class="fa fa-file-text-o"/><span><b>Contrats actifs</b><strong><t t-esc="state.data.contracts"/></strong><small>Sans contrat : <t t-esc="state.data.no_contract"/></small></span></button>
          <button class="pt-hr-v2-kpi pink" t-on-click="() => this.openLeaves([['state', 'in', ['confirm', 'validate1']]])"><i class="fa fa-star"/><span><b>Congés à approuver</b><strong><t t-esc="state.data.leave_pending"/></strong><small>Demandes en attente</small></span></button>
        </section>

        <section class="pt-hr-v2-charts">
          <article><h3><i class="fa fa-bar-chart"/> Présences par département</h3><div class="pt-hr-v2-chart"><canvas id="hrPresenceChart"/></div></article>
          <article><h3><i class="fa fa-pie-chart"/> Répartition des employés</h3><div class="pt-hr-v2-donut"><canvas id="hrDepartmentChart"/><div><t t-foreach="state.data.department_cards || []" t-as="row" t-key="row.id"><button t-on-click="() => this.openEmployees([['department_id', '=', row.id]])"><span><t t-esc="row.name"/></span><b><t t-esc="row.count"/></b><em><t t-esc="pct(row.percent)"/></em></button></t></div></div></article>
          <article><h3><i class="fa fa-briefcase"/> Situation des contrats</h3><div class="pt-hr-v2-bars"><button t-on-click="() => this.openContracts([['state', '=', 'open']])"><span>Contrats actifs</span><b t-att-style="'width:%s%%' % (state.data.contracts * 8)"><t t-esc="state.data.contracts"/></b></button><button t-on-click="() => this.openContracts([['date_end', '&lt;=', state.data.alert_date]])"><span>Expirant sous 30 jours</span><b class="orange" t-att-style="'width:%s%%' % (state.data.contracts_expiring * 20)"><t t-esc="state.data.contracts_expiring"/></b></button><button t-on-click="() => this.openEmployees([['id', 'in', state.data.no_contract_employee_ids]])"><span>Sans contrat</span><b class="red" t-att-style="'width:%s%%' % (state.data.no_contract * 20)"><t t-esc="state.data.no_contract"/></b></button></div></article>
          <article><h3><i class="fa fa-line-chart"/> Indicateurs de paie</h3><div class="pt-hr-v2-bars"><button t-on-click="() => this.openPayroll()"><span>Bulletins à générer</span><b><t t-esc="state.data.payroll.to_generate"/></b></button><button t-on-click="() => this.openPayroll([['state', '=', 'verify']])"><span>Bulletins à valider</span><b class="violet"><t t-esc="state.data.payroll.to_validate"/></b></button><button t-on-click="() => this.openPayroll([['state', '=', 'done']])"><span>Bulletins confirmés</span><b class="green"><t t-esc="state.data.payroll.validated"/></b></button></div></article>
        </section>

        <section class="pt-hr-v2-tables">
          <article><h3><i class="fa fa-building"/> Effectifs par département <button t-on-click="() => this.openEmployees()">Voir tout</button></h3><div class="pt-hr-scroll"><table><thead><tr><th>Département</th><th>Effectif</th><th>Part</th></tr></thead><tbody><tr t-foreach="state.data.department_cards || []" t-as="row" t-key="row.id" t-on-click="() => this.openEmployees([['department_id', '=', row.id]])"><td><t t-esc="row.name"/></td><td><t t-esc="row.count"/></td><td><span class="pt-hr-progress"><i t-att-style="'width:%s%%' % row.percent"/><em><t t-esc="pct(row.percent)"/></em></span></td></tr></tbody></table></div></article>
          <article><h3><i class="fa fa-exclamation-circle"/> Alertes RH <button t-on-click="() => this.openEmployees()">Voir tout</button></h3><div class="pt-hr-scroll pt-hr-alert-list"><button t-on-click="() => this.openContracts([['date_end', '&lt;=', state.data.alert_date]])"><span>Contrats arrivant à échéance</span><b><t t-esc="state.data.alerts.contracts_expiring"/></b></button><button t-on-click="() => this.openLeaves([['state', 'in', ['confirm', 'validate1']]])"><span>Congés à approuver</span><b><t t-esc="state.data.alerts.leave_pending"/></b></button><button t-on-click="() => this.openAttendances()"><span>Pointages incomplets</span><b><t t-esc="state.data.alerts.incomplete_attendances"/></b></button><button t-on-click="() => this.openEmployees([['id', 'in', state.data.absent_employee_ids]])"><span>Absences à justifier</span><b><t t-esc="state.data.alerts.unjustified_absences"/></b></button><button t-on-click="() => this.openEmployees([['id', 'in', state.data.no_contract_employee_ids]])"><span>Employés sans contrat</span><b><t t-esc="state.data.no_contract"/></b></button></div></article>
          <article><h3><i class="fa fa-file-pdf-o"/> Rapports RH</h3><div class="pt-hr-report-actions"><button t-on-click="() => this.openReport('primetech_reporting_center.action_hr_headcount_report')"><i class="fa fa-users"/> Effectif</button><button t-on-click="() => this.openReport('primetech_reporting_center.action_hr_attendance_report')"><i class="fa fa-clock-o"/> Présences</button><button t-on-click="() => this.openReport('primetech_reporting_center.action_hr_leave_report')"><i class="fa fa-calendar"/> Congés</button><button t-on-click="() => this.openReport('primetech_reporting_center.action_hr_payroll_mass_report')"><i class="fa fa-money"/> Masse salariale</button></div></article>
        </section>
      </t>
    </main>
  </t>
</templates>
