<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve"><t t-name="primetech_reporting_center.PurchaseOverviewDashboard" owl="1"><main class="pt-purchase-overview pt-purchase-v2"><t t-if="state.loading"><div class="pt-purchase-loading"><i class="fa fa-spinner fa-spin fa-3x"/> Chargement du tableau de bord…</div></t><t t-else=""><header class="pt-a2-header"><div class="pt-a2-title"><span class="pt-a2-title-icon"><i class="fa fa-shopping-cart"/></span><div><h1>Tableau de bord – Achats</h1><p>Vue d’ensemble des approvisionnements de l’entreprise</p></div></div><div class="pt-a2-filters"><label class="pt-a2-filter-label pt-a2-period-control">Période<select t-model="state.period" t-on-change="onGlobalPeriodChange"><option value="today">Aujourd'hui</option><option value="week">Cette semaine</option><option value="month">Ce mois</option><option value="quarter">Ce trimestre</option><option value="year">Cette année</option><option value="custom">Période</option></select></label><t t-if="state.period === 'custom'"><label class="pt-a2-filter-label">Du <input type="date" t-model="state.dateFrom" t-on-change="(ev) => this.onGlobalDateChange('dateFrom', ev)"/></label><label class="pt-a2-filter-label">Au <input type="date" t-model="state.dateTo" t-on-change="(ev) => this.onGlobalDateChange('dateTo', ev)"/></label></t></div></header>
<section class="pt-a2-kpis"><button class="tone-blue" t-on-click="() => this.openOrders()"><i class="fa fa-shopping-cart"/><span>Montant des achats</span><strong><t t-esc="money(state.data.total_ht)"/></strong><em><t t-esc="pct(state.data.growth_percentage)"/></em></button><button class="tone-emerald" t-on-click="() => this.openReceipts()"><i class="fa fa-clipboard"/><span>Réceptions</span><strong><t t-esc="money(state.data.receipt_amount)"/></strong><em><t t-esc="state.data.cycle.to_receive"/> en attente</em></button><button class="tone-purple" t-on-click="() => this.openOrders()"><i class="fa fa-file-text-o"/><span>Commandes d’achat</span><strong><t t-esc="state.data.purchase_count"/></strong><em><t t-esc="pct(state.data.order_growth)"/></em></button><button class="tone-orange" t-on-click="() => this.openOrders()"><i class="fa fa-database"/><span>Montant moyen / commande</span><strong><t t-esc="money(state.data.purchase_count ? state.data.total_ht / state.data.purchase_count : 0)"/></strong><em><t t-esc="pct(state.data.growth_percentage)"/></em></button><button class="tone-teal" t-on-click="() => this.openProducts()"><i class="fa fa-cube"/><span>Quantité achetée</span><strong><t t-esc="Math.round(state.data.quantity_purchased || 0)"/></strong><em><t t-esc="pct(state.data.quantity_purchased_growth)"/></em></button><button class="tone-rose" t-on-click="() => this.openSuppliers()"><i class="fa fa-truck"/><span>Fournisseurs actifs</span><strong><t t-esc="state.data.supplier_count"/></strong><em>période sélectionnée</em></button><button class="tone-yellow" t-on-click="() => this.openOrders([['state','in',['draft','sent']]])"><i class="fa fa-clock-o"/><span>Commandes en attente</span><strong><t t-esc="state.data.pending_order_count"/></strong><em><t t-esc="pct(state.data.pending_order_growth)"/></em></button><button class="tone-red" t-on-click="() => this.openReceipts([['scheduled_date','&lt;',state.data.today],['state','not in',['done','cancel']]])"><i class="fa fa-exclamation-circle"/><span>Réceptions en retard</span><strong><t t-esc="state.data.late_receipts_count"/></strong><em><t t-esc="pct(state.data.late_receipts_growth)"/></em></button><button class="tone-cyan" t-on-click="() => this.openBills([['move_type','=','in_refund']])"><i class="fa fa-undo"/><span>Retours fournisseurs</span><strong><t t-esc="money(state.data.refund_amount)"/></strong><em><t t-esc="state.data.refund_count"/> documents</em></button><button class="tone-indigo" t-on-click="() => this.openOrders()"><i class="fa fa-percent"/><span>Remises obtenues</span><strong><t t-esc="money(state.data.savings_amount)"/></strong><em><t t-esc="pct(state.data.savings_growth)"/></em></button></section>
<section class="pt-a2-charts pt-purchase-charts"><article><h3><i class="fa fa-line-chart"/> Montant des achats et réceptions</h3><canvas id="pt_purchase_evolution_chart"/></article><article><h3><i class="fa fa-pie-chart"/> Achats par catégorie de produits</h3><canvas id="pt_purchase_category_chart"/></article><article><h3><i class="fa fa-bar-chart"/> Nombre de commandes</h3><canvas id="pt_purchase_orders_chart"/></article><article><h3><i class="fa fa-line-chart"/> Évolution du coût d’achat moyen</h3><canvas id="pt_purchase_average_chart"/></article></section>
<section class="pt-purchase-tables"><article><h3>Balance âgée des fournisseurs <button t-on-click="() => this.openBills([['payment_state','!=','paid']])">Voir tout</button></h3><div class="pt-purchase-scroll"><table><thead><tr><th>Indicateur</th><th>Montant</th></tr></thead><tbody><tr t-on-click="() => this.openBills([['payment_state','!=','paid']])"><td>Factures fournisseurs ouvertes</td><td><t t-esc="money(state.data.billed_amount - state.data.paid_amount)"/></td></tr><tr t-on-click="() => this.openBills()"><td>Factures fournisseurs</td><td><t t-esc="money(state.data.billed_amount)"/></td></tr></tbody></table></div></article><article><h3>Réceptions en attente <button t-on-click="() => this.openReceipts([['state','not in',['done','cancel']]])">Voir tout</button></h3><div class="pt-purchase-scroll"><table><thead><tr><th>Fournisseur</th><th>Référence</th><th>Date prévue</th><th>Statut</th></tr></thead><tbody><tr t-foreach="state.data.last_receipts || []" t-as="row" t-key="row.id" t-on-click="() => this.openReceipts([['id','=',row.id]])"><td><t t-esc="row.supplier"/></td><td><t t-esc="row.name"/></td><td><t t-esc="row.date"/></td><td><t t-esc="row.state"/></td></tr></tbody></table></div></article></section>
<section class="pt-purchase-bottom"><article><h3>Top produits achetés <button t-on-click="() => this.openProducts()">Voir tout</button></h3><div class="pt-purchase-scroll"><table><thead><tr><th>Produit</th><th>Quantité</th><th>Montant</th></tr></thead><tbody><tr t-foreach="state.data.top_products || []" t-as="row" t-key="row.id" t-on-click="() => this.openProducts([row.id])"><td><t t-esc="row.name"/></td><td><t t-esc="Math.round(row.qty)"/></td><td><t t-esc="money(row.amount)"/></td></tr></tbody></table></div></article><article><h3>Top fournisseurs <button t-on-click="() => this.openSuppliers()">Voir tout</button></h3><div class="pt-purchase-scroll"><table><thead><tr><th>Fournisseur</th><th>Montant</th><th>Délai</th></tr></thead><tbody><tr t-foreach="state.data.top_suppliers || []" t-as="row" t-key="row.id" t-on-click="() => this.openSuppliers([row.id])"><td><t t-esc="row.name"/></td><td><t t-esc="money(row.amount)"/></td><td><t t-esc="row.delay"/> j</td></tr></tbody></table></div></article><article><h3><i class="fa fa-print"/> Rapports d’achats</h3><div class="pt-a2-financial"><button t-on-click="() => this.openWizard('primetech_reporting_center.action_purchase_analysis_report')">Analyse des achats</button><button t-on-click="() => this.openWizard('primetech_reporting_center.action_purchase_supplier_report')">Achats par fournisseur</button><button t-on-click="() => this.openWizard('primetech_reporting_center.action_purchase_product_report')">Achats par produit</button><button t-on-click="() => this.openWizard('primetech_reporting_center.action_purchase_expense_report')">Dépenses d’achat</button><button t-on-click="() => this.openWizard('primetech_reporting_center.action_purchase_order_report')">Commandes d’achat</button><button t-on-click="() => this.openWizard('primetech_reporting_center.action_purchase_receipt_report')">Réceptions</button><button t-on-click="() => this.openWizard('primetech_reporting_center.action_purchase_bill_report')">Factures fournisseurs</button><button t-on-click="() => this.openWizard('primetech_reporting_center.action_purchase_supplier_perf_report')">Performance fournisseurs</button><button t-on-click="() => this.openWizard('primetech_reporting_center.action_purchase_lead_report')">Délais d’approvisionnement</button></div></article></section>
</t></main></t></templates>
