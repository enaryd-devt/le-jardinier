<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-inherit="point_of_sale.CashMovePopup" t-inherit-mode="extension" owl="1">
        <t position="before">
        <div class="row g-2 mb-2">
            <div class="col form-floating pos-customer-cash-partner-selector">
                <label class="form-label">Partenaire (cr&#233;e un paiement comptable)</label>
                <button type="button" class="form-select pos-customer-cash-partner-selector__trigger" t-on-click="togglePartnerPicker">
                    <span t-if="selectedPartner" t-esc="selectedPartner.display_name || selectedPartner.name"/>
                    <span t-else="" class="text-muted">Choisissez un partenaire</span>
                    <i class="fa fa-chevron-down" t-att-class="{ 'is-open': partnerDirectory.open }"/>
                </button>
                <label>Partenaire</label>
                <div t-if="partnerDirectory.open" class="pos-customer-cash-partner-selector__menu">
                    <div class="pos-customer-cash-partner-selector__search">
                        <i class="fa fa-search"/>
                        <input t-ref="partnerSearchInput" type="search" placeholder="Nom, t&#233;l&#233;phone, e-mail ou r&#233;f&#233;rence&#8230;" t-model="partnerDirectory.search" t-on-input="onPartnerSearch"/>
                    </div>
                    <div class="pos-customer-cash-partner-selector__results" t-on-scroll="onPartnerListScroll">
                        <button t-if="!partnerDirectory.search" type="button" class="pos-customer-cash-partner-selector__item" t-on-click="() => this.selectPartner({ id: 0, name: '' })"><span>Mouvement sans partenaire</span></button>
                        <t t-foreach="partnerDirectory.items" t-as="partner" t-key="partner.id">
                            <button type="button" class="pos-customer-cash-partner-selector__item" t-on-click="() => this.selectPartner(partner)">
                                <strong t-esc="partner.display_name || partner.name"/>
                                <small t-if="partner.phone || partner.mobile || partner.email" t-esc="partner.phone || partner.mobile || partner.email"/>
                            </button>
                        </t>
                        <div t-if="partnerDirectory.loading" class="pos-customer-cash-partner-selector__status"><i class="fa fa-spinner fa-spin"/> Chargement&#8230;</div>
                        <div t-elif="!partnerDirectory.items.length" class="pos-customer-cash-partner-selector__status">Aucun contact trouv&#233;.</div>
                    </div>
                </div>
            </div>
            <div t-if="hasSelectedPartner" class="col form-floating">
                <select class="form-select" id="pos-partner-payment-method" t-model="state.pos_payment_method_id" t-att-disabled="partnerPaymentModes.loading || !hasSelectedPartner">
                    <option value="">Choisir un mode de paiement</option>
                    <t t-foreach="partnerPaymentModes.items" t-as="method" t-key="method.id">
                        <option t-att-value="method.id"><t t-esc="method.name"/></option>
                    </t>
                </select>
                <label for="pos-partner-payment-method">Mode de paiement</label>
            </div>
            <div t-if="hasSelectedPartner" class="col form-floating">
                <select class="form-select" id="pos-partner-account-type" t-model="state.partner_type" t-att-disabled="!hasSelectedPartner">
                    <option value="">Aucun compte — lettrage manuel ultérieur</option>
                    <option value="customer">Compte client</option>
                    <option value="supplier">Compte fournisseur</option>
                </select>
                <label for="pos-partner-account-type">Compte de lettrage</label>
            </div>
        </div>
        </t>
    </t>

    <t t-inherit="point_of_sale.Navbar" t-inherit-mode="extension" owl="1">
        <DropdownItem t-if="showCashMoveButton" position="after">
            <DropdownItem onSelected="() => this.showCustomerCashPayments()">Paiements partenaires POS</DropdownItem>
        </DropdownItem>
    </t>

    <t t-name="primetech_pos_customer_cash_payment.CustomerCashPaymentReceipt">
        <div class="pos-receipt customer-cash-payment-receipt">
            <div class="customer-cash-payment-receipt__header">
                <img t-if="props.headerData.company.logo" class="customer-cash-payment-receipt__logo" t-att-src="props.headerData.company.logo" alt="Logo"/>
                <div class="customer-cash-payment-receipt__company">
                    <strong t-esc="props.headerData.company.name"/>
                    <span t-if="props.headerData.company.phone" t-esc="'Tél. : ' + props.headerData.company.phone"/>
                    <span t-if="props.headerData.company.vat" t-esc="'N° TVA : ' + props.headerData.company.vat"/>
                    <span t-if="props.headerData.company.email" t-esc="props.headerData.company.email"/>
                </div>
            </div>
            <div class="customer-cash-payment-receipt__title">PAIEMENT <span t-esc="'N° ' + props.receipt.name"/></div>

            <section class="customer-cash-payment-receipt__customer-card">
                <div class="customer-cash-payment-receipt__customer">
                    <span>Partenaire</span>
                    <strong t-esc="props.receipt.partner_name"/>
                </div>
                <div class="customer-cash-payment-receipt__meta">
                    <span>Date et heure</span><strong t-esc="props.receipt.date"/>
                    <span t-esc="props.receipt.payment_type === 'inbound' ? 'Encaissé par' : 'Payé par'"/><strong t-esc="props.receipt.cashier_name || '—'"/>
                </div>
            </section>

            <section class="customer-cash-payment-receipt__summary">
                <div class="customer-cash-payment-receipt__line"><span t-esc="'Solde global avant — ' + (props.receipt.balance_before_label || '')"/><strong t-esc="formatAccountBalance(props.receipt.balance_before)"/></div>
                <div class="customer-cash-payment-receipt__paid"><span t-esc="props.receipt.payment_type === 'inbound' ? 'Montant encaissé' : 'Montant versé'"/><strong t-esc="formatAmount(props.receipt.amount)"/></div>
                <div class="customer-cash-payment-receipt__line"><span t-esc="'Solde global après paiement — ' + (props.receipt.balance_after_label || '')"/><strong t-esc="formatAccountBalance(props.receipt.balance_after)"/></div>
                <div t-if="props.receipt.reason" class="customer-cash-payment-receipt__line"><span>Motif</span><strong t-esc="props.receipt.reason"/></div>
            </section>

            <div class="customer-cash-payment-receipt__thanks">Merci pour votre confiance !</div>
        </div>
    </t>

    <t t-name="primetech_pos_customer_cash_payment.PartnerBalanceReceipt">
        <div class="pos-receipt customer-cash-payment-receipt">
            <div class="customer-cash-payment-receipt__header">
                <img t-if="props.headerData.company.logo" class="customer-cash-payment-receipt__logo" t-att-src="props.headerData.company.logo" alt="Logo"/>
                <div class="customer-cash-payment-receipt__company"><strong t-esc="props.headerData.company.name"/></div>
            </div>
            <div class="customer-cash-payment-receipt__title">SOLDE PARTENAIRE</div>
            <section class="customer-cash-payment-receipt__customer-card">
                <div class="customer-cash-payment-receipt__customer"><span>Partenaire</span><strong t-esc="props.balance.partner_name"/></div>
            </section>
            <section class="customer-cash-payment-receipt__summary">
                <div class="customer-cash-payment-receipt__paid"><span t-esc="props.balance.direction"/><strong t-esc="formatAmount(props.balance.amount)"/></div>
            </section>
            <div class="customer-cash-payment-receipt__thanks">Situation globale du partenaire</div>
        </div>
    </t>

    <t t-name="primetech_pos_customer_cash_payment.PartnerBalancePopup">
        <Dialog title="'Solde partenaire'" size="'md'">
            <div class="p-2">
                <label class="form-label">Rechercher un partenaire</label>
                <input class="form-control" type="search" autofocus="autofocus" placeholder="Nom, téléphone, e-mail ou référence…" t-att-value="state.search" t-on-input="onSearchInput"/>
                <div class="list-group mt-3" style="max-height: 260px; overflow-y: auto;">
                    <button t-foreach="state.partners" t-as="partner" t-key="partner.id" type="button" class="list-group-item list-group-item-action" t-att-class="{'active': state.selectedPartner &amp;&amp; state.selectedPartner.id === partner.id}" t-on-click="() => selectPartner(partner)">
                        <strong t-esc="partner.display_name || partner.name"/>
                        <small class="d-block" t-if="partner.phone || partner.mobile || partner.email" t-esc="partner.phone || partner.mobile || partner.email"/>
                    </button>
                    <div t-if="state.loading" class="text-center text-muted p-3"><i class="fa fa-spinner fa-spin"/> Chargement…</div>
                    <div t-if="!state.loading &amp;&amp; !state.partners.length" class="text-center text-muted p-3">Aucun partenaire trouvé.</div>
                </div>
                <div t-if="state.balance" class="border rounded bg-light mt-3 p-3 text-center">
                    <div class="fw-semibold" t-esc="state.balance.direction"/>
                    <div t-att-class="{'fs-4': true, 'fw-bold': true, 'text-success': state.balance.direction_code === 'company_owes', 'text-dark': state.balance.direction_code !== 'company_owes'}" t-esc="env.utils.formatCurrency(state.balance.amount || 0)"/>
                    <small class="text-muted">Solde global client et fournisseur</small>
                </div>
            </div>
            <t t-set-slot="footer">
                <button class="btn btn-secondary" t-on-click="props.close">Annuler</button>
                <button class="btn btn-primary" t-att-disabled="!state.balance" t-on-click="print"><i class="fa fa-print"/> Imprimer</button>
            </t>
        </Dialog>
    </t>

    <t t-name="primetech_pos_customer_cash_payment.CustomerCashPaymentsScreen">
        <div class="customer-cash-payments-screen screen">
            <div class="customer-cash-payments-screen__header">
                <button class="btn customer-cash-payments-screen__back" t-on-click="back"><i class="fa fa-arrow-left"/> Retour au POS</button>
                <div><span>Point de vente</span><h4>Paiements partenaires</h4></div>
                <button class="btn customer-cash-payments-screen__partner-balance" t-on-click="openPartnerBalanceWizard">
                    <i class="fa fa-balance-scale"/> Solde partenaire
                </button>
            </div>
            <main class="customer-cash-payments">
                <div class="customer-cash-payments__search">
                    <i class="fa fa-search"/>
                    <input class="form-control" type="search" placeholder="Rechercher un client, un numéro ou un motif…" t-att-value="state.searchTerm" t-on-input="onSearchInput"/>
                    <button t-if="state.searchTerm" class="btn btn-link" title="Effacer la recherche" t-on-click="() => { state.searchTerm = ''; state.page = 0; loadPayments(); }"><i class="fa fa-times"/></button>
                    <button class="btn customer-cash-payments__refresh" t-att-disabled="state.loading" title="Actualiser les paiements" t-on-click="refresh"><i t-att-class="{ 'fa': true, 'fa-refresh': true, 'fa-spin': state.loading }"/></button>
                </div>
                <div t-if="state.loading" class="customer-cash-payments__loading"><i class="fa fa-circle-o-notch fa-spin"/><span>Chargement des paiements…</span></div>
                <div t-else="" class="customer-cash-payments__table-wrap">
                    <table class="customer-cash-payments__table">
                        <thead><tr><th>Date</th><th>Référence</th><th>Partenaire</th><th>Compte de lettrage</th><th>Mode de règlement</th><th class="text-end">Montant</th><th aria-label="Actions"/></tr></thead>
                        <tbody>
                            <tr t-foreach="state.payments" t-as="payment" t-key="payment.id">
                                <td class="customer-cash-payments__date" t-esc="payment.date"/>
                                <td><span class="customer-cash-payments__reference" t-esc="payment.name"/></td>
                                <td><span class="customer-cash-payments__customer" t-esc="payment.partner_name"/><small t-if="payment.reason" t-esc="payment.reason"/></td>
                                <td t-esc="payment.reconciliation_account"/><td t-esc="payment.payment_method_name"/><td t-att-class="{ 'customer-cash-payments__amount': true, 'customer-cash-payments__amount--outbound': payment.payment_type === 'outbound' }" t-esc="format(payment.amount)"/>
                                <td class="text-end"><button class="btn customer-cash-payments__print" title="Réimprimer le reçu" t-on-click="() => print(payment)"><i class="fa fa-print"/><span>Imprimer</span></button></td>
                            </tr>
                            <tr t-if="!state.payments.length"><td colspan="7"><div class="customer-cash-payments__empty"><i class="fa fa-folder-open-o"/><strong>Aucun paiement trouvé</strong><span>Essayez une autre recherche ou enregistrez un nouveau paiement partenaire.</span></div></td></tr>
                        </tbody>
                    </table>
                </div>
            </main>
            <footer class="customer-cash-payments-screen__footer">
                <span class="customer-cash-payments__page">Page <t t-esc="state.page + 1"/> sur <t t-esc="totalPages"/></span>
                <div class="d-flex gap-2">
                    <button class="btn btn-light" t-att-disabled="state.page === 0" t-on-click="() => changePage(-1)">Pr&#233;c&#233;dent</button>
                    <button class="btn btn-light" t-att-disabled="state.page + 1 >= totalPages" t-on-click="() => changePage(1)">Suivant</button>
                </div>
            </footer>
        </div>
    </t>
</templates>
