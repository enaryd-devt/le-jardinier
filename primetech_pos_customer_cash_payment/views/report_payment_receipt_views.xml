<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Replace the former brittle inheritance with an inactive, standalone
         QWeb view. The customized A4 payment receipt remains untouched. -->
    <record id="report_payment_receipt_positive_amounts" model="ir.ui.view">
        <field name="name">primetech.pos.payment.receipt.disabled</field>
        <field name="type">qweb</field>
        <field name="inherit_id" eval="False"/>
        <field name="active" eval="False"/>
        <field name="arch" type="xml">
            <t t-name="primetech_pos_customer_cash_payment.payment_receipt_disabled"/>
        </field>
    </record>
    <record id="report_payment_receipt_real_partner_balance" model="ir.ui.view">
        <field name="name">primetech.pos.payment.receipt.balance.disabled</field>
        <field name="type">qweb</field>
        <field name="inherit_id" eval="False"/>
        <field name="active" eval="False"/>
        <field name="arch" type="xml">
            <t t-name="primetech_pos_customer_cash_payment.payment_receipt_balance_disabled"/>
        </field>
    </record>
    <function model="ir.ui.view" name="primetech_update_payment_receipt_template">
        <value eval="[]"/>
    </function>
</odoo>
