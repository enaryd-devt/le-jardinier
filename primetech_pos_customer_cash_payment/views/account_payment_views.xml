<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_payment_search_pos_customer_cash" model="ir.ui.view">
        <field name="name">account.payment.search.pos.customer.cash</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_search"/>
        <field name="arch" type="xml">
            <filter name="inbound_filter" position="after">
                <filter string="Espèces client POS" name="pos_customer_cash" domain="[('pos_customer_cash_payment', '=', True)]"/>
            </filter>
        </field>
    </record>
    <record id="view_account_payment_tree_partner_balance" model="ir.ui.view">
        <field name="name">account.payment.list.partner.balance</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_tree"/>
        <field name="active" eval="True"/>
        <field name="arch" type="xml">
            <xpath expr="//list/header" position="inside">
                <button name="%(action_partner_balance_receipt_wizard)d" type="action"
                        string="Solde partenaire" display="always" class="btn-secondary"/>
            </xpath>
        </field>
    </record>
    <record id="view_account_payment_form_partner_balance" model="ir.ui.view">
        <field name="name">account.payment.form.partner.balance.disabled</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" eval="False"/>
        <field name="active" eval="False"/>
        <field name="arch" type="xml"><form/></field>
    </record>
    <record id="action_pos_customer_cash_payments" model="ir.actions.act_window">
        <field name="name">Paiements clients POS</field>
        <field name="res_model">account.payment</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('pos_customer_cash_payment', '=', True)]</field>
        <field name="context">{'search_default_pos_customer_cash': 1}</field>
    </record>
</odoo>
